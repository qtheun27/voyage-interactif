rules_version = '2';
// Mon carnet de voyages : tout est sous trips/…, users/… et config/….
// Si ce fichier est fusionné avec des règles existantes, copier seulement le contenu
// entre « DÉBUT VOYAGE INTERACTIF » et « FIN VOYAGE INTERACTIF » dans le bloc
// match /databases/{database}/documents existant.
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== DÉBUT VOYAGE INTERACTIF =====
    // Compte Google, ou e-mail + mot de passe dont l'adresse a été vérifiée.
    function viSignedInWithGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'password']
        && request.auth.token.email_verified == true;
    }
    function viIsOwner() {
      return viSignedInWithGoogle() && request.auth.token.email == 'q.theuninck@gmail.com';
    }
    function viIsEditor() {
      return viIsOwner()
        || (viSignedInWithGoogle()
            && request.auth.token.email in get(/databases/$(database)/documents/config/editors).data.emails);
    }
    function viIsMember(tripId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    function viCanSee(tripId) {
      return viIsMember(tripId) || viIsEditor();
    }

    // Profil d'un compte (photo choisie dans la galerie) : lisible et modifiable par son seul titulaire.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if viSignedInWithGoogle() && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.data.keys().hasOnly(['photo', 'updatedAt'])
                && (!('photo' in request.resource.data)
                    || (request.resource.data.photo is bytes && request.resource.data.photo.size() < 150000))));
    }

    match /config/editors {
      allow read: if viIsEditor();
      allow write: if viIsOwner();
    }

    // Réglages du stockage des vidéos (clé Backblaze) : jamais lisibles par les visiteurs.
    match /config/storage {
      allow read: if viIsEditor();
      allow write: if viIsOwner();
    }

    match /trips/{tripId} {
      allow get: if viIsMember(tripId) || viIsEditor();
      allow list: if viIsEditor();
      allow write: if viIsEditor();

      match /stops/{stopId} {
        allow read: if viIsMember(tripId) || viIsEditor();
        allow write: if viIsEditor();
      }

      // Photos en grand (JPEG dans un champ Bytes, moins de 1 Mio), chargées à la demande.
      match /photos/{stopId} {
        allow read: if viIsMember(tripId) || viIsEditor();
        allow write: if viIsEditor();
      }

      // Réactions : un document par photo, un champ par personne (uid -> « emoji|prénom »).
      // Chacun ne touche qu'à son propre champ.
      match /reactions/{photoId} {
        allow read: if viCanSee(tripId);
        allow create: if viCanSee(tripId)
          && request.resource.data.keys().hasOnly([request.auth.uid])
          && request.resource.data[request.auth.uid] is string
          && request.resource.data[request.auth.uid].size() <= 80;
        allow update: if viCanSee(tripId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data)
              || (request.resource.data[request.auth.uid] is string
                  && request.resource.data[request.auth.uid].size() <= 80));
        allow delete: if viIsEditor();
      }

      // Commentaires sur les étapes : jamais modifiés, supprimés par leur auteur ou un éditeur.
      match /comments/{commentId} {
        allow read: if viCanSee(tripId);
        allow create: if viCanSee(tripId)
          && request.resource.data.keys().hasOnly(['photoId', 'text', 'name', 'uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.photoId is string && request.resource.data.photoId.size() <= 120
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.at == request.time;
        allow delete: if viIsEditor() || (request.auth != null && resource.data.uid == request.auth.uid);
      }

      // L'id du document est le code d'accès : jamais lisible ni listable par les visiteurs.
      match /codes/{code} {
        allow read: if viIsEditor();
        allow write: if viIsEditor();
      }

      match /members/{uid} {
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['code', 'joinedAt'])
          && request.resource.data.code is string
          && request.resource.data.code.matches('^[A-Z0-9-]{4,40}$')
          && exists(/databases/$(database)/documents/trips/$(tripId)/codes/$(request.resource.data.code));
        allow get: if request.auth != null && request.auth.uid == uid;
        allow read, delete: if viIsEditor();
      }
    }
    // ===== FIN VOYAGE INTERACTIF =====
  }
}
